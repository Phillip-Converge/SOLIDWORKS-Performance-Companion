                                <DataTemplate>
                                    <StackPanel Margin="{Binding Spacing}" Width="16" ToolTip="{Binding Tip}" Background="Transparent">
                                        <!-- thin line graphic: dim track, coloured level -->
                                        <Grid Height="52" Width="6" HorizontalAlignment="Center">
                                            <Rectangle Fill="{StaticResource ScreenDim}" Width="2" HorizontalAlignment="Center" />
                                            <Rectangle VerticalAlignment="Bottom" Height="{Binding BarHeight}" Fill="{Binding Fill}" RadiusX="1" RadiusY="1" />
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource ScreenLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding TypeLetter}" Style="{StaticResource ScreenLabel}" FontSize="8"
                                                   HorizontalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- what this means, in everyday words -->
                <TextBlock Text="what this means" Style="{StaticResource Label}" Margin="2,14,0,4" />
                <TextBlock x:Name="ExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,0" />

                <!-- why? questions: click one to open its answer, click again to close -->
                <TextBlock Text="ask why" Style="{StaticResource Label}" Margin="2,14,0,6" />
                <WrapPanel x:Name="QuestionKeys" />
                <Border x:Name="AnswerBox" Style="{StaticResource AnswerPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="AnswerTitle" Style="{StaticResource SectionName}" Margin="0,0,0,6" />
                        <TextBlock x:Name="AnswerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 03 memory ===== -->
        <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="03" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="memory" Style="{StaticResource SectionName}" />
                    <TextBlock Text="every 2 s   orange = solidworks's share" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <Border Style="{StaticResource ScreenPanel}">
                    <StackPanel>
                        <TextBlock x:Name="MemorySummaryText" TextWrapping="Wrap" FontSize="15"
                                   Foreground="{StaticResource ScreenText}" Text="measuring..." />
                        <TextBlock x:Name="MemoryDetailText" Style="{StaticResource ScreenLabel}" Margin="0,6,0,12" TextWrapping="Wrap" />
                        <ItemsControl x:Name="MemoryMeters">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10" ToolTip="{Binding Tip}" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource ScreenLabel}" VerticalAlignment="Center" />
                                        <!-- thin bar: orange part, plain part, empty remainder -->
                                        <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                            <Rectangle Fill="{StaticResource ScreenDim}" RadiusX="1" RadiusY="1" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding First}" />
                                                    <ColumnDefinition Width="{Binding Second}" />
                                                    <ColumnDefinition Width="{Binding Rest}" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Fill="{Binding FirstFill}" />
                                                <Rectangle Grid.Column="1" Fill="{Binding SecondFill}" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="what this means" Style="{StaticResource Label}" Margin="2,14,0,4" />
                <TextBlock x:Name="MemoryExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,0" />

                <TextBlock Text="ask why" Style="{StaticResource Label}" Margin="2,14,0,6" />
                <WrapPanel x:Name="MemoryKeys" />
                <Border x:Name="MemoryAnswerBox" Style="{StaticResource AnswerPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="MemoryAnswerTitle" Style="{StaticResource SectionName}" Margin="0,0,0,6" />
                        <TextBlock x:Name="MemoryAnswerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 04 graphics ===== -->
        <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="04" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="graphics" Style="{StaticResource SectionName}" />
                    <TextBlock Text="every 2 s   orange = solidworks's share" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <Border Style="{StaticResource ScreenPanel}">
                    <StackPanel>
                        <TextBlock x:Name="GpuSummaryText" TextWrapping="Wrap" FontSize="15"
                                   Foreground="{StaticResource ScreenText}" Text="measuring..." />
                        <TextBlock x:Name="GpuDetailText" Style="{StaticResource ScreenLabel}" Margin="0,6,0,12" TextWrapping="Wrap" />
                        <ItemsControl x:Name="GpuMeters" ItemTemplate="{Binding ItemTemplate, ElementName=MemoryMeters}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="what this means" Style="{StaticResource Label}" Margin="2,14,0,4" />
                <TextBlock x:Name="GpuExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,0" />

                <TextBlock Text="ask why" Style="{StaticResource Label}" Margin="2,14,0,6" />
                <WrapPanel x:Name="GpuKeys" />
                <Border x:Name="GpuAnswerBox" Style="{StaticResource AnswerPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="GpuAnswerTitle" Style="{StaticResource SectionName}" Margin="0,0,0,6" />
                        <TextBlock x:Name="GpuAnswerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 05 disk and network ===== -->
        <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="05" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="disk and network" Style="{StaticResource SectionName}" />
                    <TextBlock Text="every 2 s" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <Border Style="{StaticResource ScreenPanel}">
                    <StackPanel>
                        <TextBlock x:Name="IoSummaryText" TextWrapping="Wrap" FontSize="15"
                                   Foreground="{StaticResource ScreenText}" Text="measuring..." />
                        <TextBlock x:Name="IoDetailText" Style="{StaticResource ScreenLabel}" Margin="0,6,0,12" TextWrapping="Wrap" />
                        <ItemsControl x:Name="IoMeters" ItemTemplate="{Binding ItemTemplate, ElementName=MemoryMeters}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="what this means" Style="{StaticResource Label}" Margin="2,14,0,4" />
                <TextBlock x:Name="IoExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,0" />

                <TextBlock Text="ask why" Style="{StaticResource Label}" Margin="2,14,0,6" />
                <WrapPanel x:Name="IoKeys" />
                <Border x:Name="IoAnswerBox" Style="{StaticResource AnswerPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="IoAnswerTitle" Style="{StaticResource SectionName}" Margin="0,0,0,6" />
                        <TextBlock x:Name="IoAnswerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 06 files (file tracing, needs administrator) ===== -->
        <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="06" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="files" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="FilesStatusLabel" Text="file tracing: off" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,0,0,10" x:Name="AdminRow">
                    <Button x:Name="RestartAdminKey" DockPanel.Dock="Right" Content="restart as administrator" Style="{StaticResource KeyButton}"
                            Margin="12,0,0,0" Click="RestartAdminKey_Click" VerticalAlignment="Top" />
                    <TextBlock x:Name="AdminText" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                               Text="File tracing shows each file SOLIDWORKS opens, how long it waited, where it came from and whether Windows Defender held it up. Windows only allows this for administrators. Restarting as administrator shows a Windows permission prompt; the Companion stays read only." />
                </DockPanel>
                <Border Style="{StaticResource ScreenPanel}">
                    <StackPanel>
                        <TextBlock x:Name="FilesSummaryText" TextWrapping="Wrap" FontSize="15"
                                   Foreground="{StaticResource ScreenText}" Text="File tracing is off." />
                        <ItemsControl x:Name="FileRows" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Details}" Style="{StaticResource ScreenLabel}" TextWrapping="Wrap" Margin="10,0" />
                                        <Border Grid.Column="2" Style="{StaticResource Tag}" Background="{StaticResource Warn}" Visibility="{Binding ScanVisibility}">
                                            <TextBlock Text="scanned" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TagText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="what this means" Style="{StaticResource Label}" Margin="2,14,0,4" />
                <TextBlock x:Name="FilesExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,0" />

                <TextBlock Text="ask why" Style="{StaticResource Label}" Margin="2,14,0,6" />
                <WrapPanel x:Name="FilesKeys" />
                <Border x:Name="FilesAnswerBox" Style="{StaticResource AnswerPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FilesAnswerTitle" Style="{StaticResource SectionName}" Margin="0,0,0,6" />
                        <TextBlock x:Name="FilesAnswerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 07 pdm vault: servers, names, ports, the user's notes ===== -->
        <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="07" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="pdm vault" Style="{StaticResource SectionName}" />
                    <TextBlock Text="every 10 s   port test only when you click it" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock x:Name="VaultSummaryText" FontSize="15" TextWrapping="Wrap" Margin="2,0,0,8" Text="looking for vault views..." />
                <ComboBox x:Name="VaultPicker" Width="260" HorizontalAlignment="Left" Margin="2,0,0,10" Visibility="Collapsed"
                          SelectionChanged="VaultPicker_SelectionChanged" />

                <!-- Live traffic map: this PC, the vault's server(s), traffic between them -->
                <TextBlock Text="live traffic map" Style="{StaticResource Label}" Margin="2,4,0,6" />
                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ContentControl x:Name="MapHost" Height="200" />
                </Border>
                <DockPanel Margin="2,6,0,12">
                    <Button x:Name="MapExampleKey" DockPanel.Dock="Right" Content="show an example" Style="{StaticResource KeyButton}"
                            Margin="12,0,0,0" Click="MapExampleKey_Click" VerticalAlignment="Top" />
                    <TextBlock x:Name="MapNote" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="VaultRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" LineHeight="19">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Finding, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Live traffic to the vault's servers (file tracing, administrator) -->
                <Border Style="{StaticResource ScreenPanel}" Margin="0,6,0,10">
                    <StackPanel>
                        <TextBlock x:Name="VaultTrafficSummary" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource ScreenText}" />
                        <ItemsControl x:Name="VaultTrafficRows" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource ScreenLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VaultTrafficExplain" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,4" />
                <TextBlock x:Name="VaultTrafficPlain" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" FontStyle="Italic" Margin="2,0,0,10"
                           Foreground="{StaticResource Muted}" />
                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="PortTestKey" Content="test the server ports" Style="{StaticResource KeyButton}" Click="PortTestKey_Click" />
                </WrapPanel>
                <TextBlock x:Name="PortTestNote" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,0,0,0"
                           Text="Only when you click: knocks on each server's port, times the answer, and closes straight away. Nothing is sent to PDM or SQL Server. Each test is logged." />

                <!-- The user's notes: what the app can't detect -->
                <TextBlock Text="your notes about this vault" Style="{StaticResource Label}" Margin="2,16,0,6" />
                <Grid x:Name="VaultNotesForm" Margin="2,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="database (SQL) server is in" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="NoteDatabaseWhere" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="archive server is in" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NoteArchiveWhere" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="this PC reaches them over" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="NoteLink" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="archive replicated between sites" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="NoteReplicated" Margin="0,2" />
                    <TextBlock Grid.Row="4" Text="anything else" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="13" />
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NoteText" Margin="0,2" Height="54"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="SaveNotesKey" Content="save notes" Style="{StaticResource KeyButton}" Click="SaveNotesKey_Click" />
                        <TextBlock x:Name="NotesStatus" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0,0,8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 08 inside solidworks (the add-in) ===== -->
        <Border Style="{StaticResource ModulePanel}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="08" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="inside solidworks" Style="{StaticResource SectionName}" />
                    <TextBlock x:Name="AddinStatusLabel" Text="add-in: not connected" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <Border Style="{StaticResource ScreenPanel}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="AddinNowText" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource ScreenText}" />
                        <ItemsControl x:Name="AddinRecentRows" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource ScreenLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- The last slow sheet switch: which views are most likely holding it up -->
                <Border x:Name="AddinSheetBox" Style="{StaticResource ScreenPanel}" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="AddinSheetHeadline" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource ScreenText}" />
                        <ItemsControl x:Name="AddinSuspects" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource ScreenLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AddinSheetCaveat" Style="{StaticResource ScreenLabel}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AddinExplainText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="2,0,0,4" />
                <StackPanel x:Name="TimeViewsRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                    <Button x:Name="TimeViewsKey" Content="time each view" Style="{StaticResource KeyButton}" Click="TimeViewsKey_Click" />
                    <TextBlock x:Name="TimeViewsNote" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,8" MaxWidth="640" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== 09 programs ===== -->
        <Border Style="{StaticResource ModulePanel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="09" Style="{StaticResource SectionNumber}" />
                    <TextBlock Text="programs" Style="{StaticResource SectionName}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTip="Colour key for the type column. locked = the safety rules forbid ever stopping it.">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" Margin="0,0,4,0" /><TextBlock Text="sw" Style="{StaticResource Label}" Margin="0,0,10,0" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Info}" Margin="0,0,4,0" /><TextBlock Text="pdm" Style="{StaticResource Label}" Margin="0,0,10,0" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Warn}" Margin="0,0,4,0" /><TextBlock Text="licence" Style="{StaticResource Label}" Margin="0,0,10,0" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Text}" Margin="0,0,4,0" /><TextBlock Text="helper" Style="{StaticResource Label}" />
                    </StackPanel>
                    <TextBlock Text="every 2 s" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </DockPanel>
                <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          PreviewMouseWheel="ProcessGrid_PreviewMouseWheel"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="type" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding TypeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RoleText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="program" Binding="{Binding ExeName}" Width="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="pid" Binding="{Binding Id}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- yellow printed tag, like a key cap -->
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource Warn}" Visibility="{Binding LockVisibility}">
                                        <TextBlock Text="locked" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TagText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="what it is" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings: look, and about this copy -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Look" Style="{StaticResource SectionName}" Margin="0,0,0,10" />
                            <TextBlock Text="Light or dark. The Companion reopens in the new look." Style="{StaticResource Label}" Margin="0,0,0,10" />
                            <WrapPanel>
<Button x:Name="ThemeKey" Content="dark mode" Style="{StaticResource KeyButton}" Margin="0" Padding="10,3"
                        VerticalAlignment="Center" Click="ThemeKey_Click" ToolTip="Switch between the light and dark look. The Companion reopens in the new look." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- Ask AI: optional, your own AI service and key -->
                    <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ask AI (optional)" Style="{StaticResource SectionName}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14" FontSize="12.5" LineHeight="18"
                                       Text="Ask your own AI about what SOLIDWORKS is doing. It uses your account and your key, and the provider bills you directly (usually a few cents a question). A Claude Pro or ChatGPT Plus subscription can't be used by other apps: you need an API key from the provider's developer site. Or run a free model on this PC (for example Ollama), and nothing leaves the PC. Names of files, folders, servers, this PC and you are hidden before anything is sent. The AI can only answer; it can't change anything." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="AI service" VerticalAlignment="Center" Margin="0,0,0,10" />
                                <WrapPanel x:Name="AiProviderChips" Grid.Column="1" Margin="0,0,0,4">
                                    <Button Content="Off" CommandParameter="off" Style="{StaticResource ReplyChip}" Padding="14,5" FontSize="13" Click="AiProvider_Click" />
                                    <Button Content="Claude (Anthropic)" CommandParameter="claude" Style="{StaticResource ReplyChip}" Padding="14,5" FontSize="13" Click="AiProvider_Click" />
                                    <Button Content="OpenAI (ChatGPT)" CommandParameter="openai" Style="{StaticResource ReplyChip}" Padding="14,5" FontSize="13" Click="AiProvider_Click" />
                                    <Button Content="A model on this PC (Ollama, LM Studio)" CommandParameter="local" Style="{StaticResource ReplyChip}" Padding="14,5" FontSize="13" Click="AiProvider_Click" />
                                </WrapPanel>

                                <TextBlock x:Name="AiKeyLabel" Grid.Row="1" Text="Your API key" VerticalAlignment="Center" Margin="0,0,0,10" />
                                <WrapPanel x:Name="AiKeyRow" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <PasswordBox x:Name="AiKeyBox" Width="280" VerticalContentAlignment="Center" Padding="4,3" Margin="0,0,8,0" />
                                    <Button Content="save key" Style="{StaticResource KeyButton}" Padding="10,3" Margin="0,0,8,0" Click="AiSaveKey_Click" />
                                    <Button Content="remove key" Style="{StaticResource KeyButton}" Padding="10,3" Margin="0,0,10,0" Click="AiRemoveKey_Click" />
                                    <TextBlock x:Name="AiKeyState" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                </WrapPanel>

                                <TextBlock x:Name="AiUrlLabel" Grid.Row="2" Text="Address" VerticalAlignment="Center" Margin="0,0,0,10" />
                                <TextBox x:Name="AiUrlBox" Grid.Row="2" Grid.Column="1" Width="280" HorizontalAlignment="Left" Padding="4,3" Margin="0,0,0,10"
                                         ToolTip="Where the model on this PC listens. Ollama: http://localhost:11434   LM Studio: http://localhost:1234" LostFocus="AiUrl_LostFocus" />

                                <TextBlock Grid.Row="3" Text="Model" VerticalAlignment="Center" Margin="0,0,0,10" />
                                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBox x:Name="AiModelBox" Width="280" Padding="4,3" VerticalAlignment="Center" Margin="0,0,8,0" VerticalContentAlignment="Center" LostFocus="AiModel_Changed" />
                                    <Button Content="check connection" Style="{StaticResource KeyButton}" Padding="10,3" Click="AiCheck_Click"
                                            ToolTip="Checks your key or address works and lists the models you can pick. Sends no SOLIDWORKS information." />
                                </WrapPanel>

                                <ScrollViewer x:Name="AiModelListScroll" Grid.Row="4" Grid.Column="1" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" Visibility="Collapsed">
                                    <ItemsControl x:Name="AiModelList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Tag="{Binding On}" Style="{StaticResource ReplyChip}" Padding="10,3" FontSize="12" Margin="0,0,6,6"
                                                        Click="AiModelPick_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,4">
                                    <CheckBox x:Name="AiPreviewEach" Content="Show me what will be sent before each question" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Click="AiPreviewEach_Click" />
                                    <Button Content="show what would be sent now" Style="{StaticResource KeyButton}" Padding="10,3" Click="AskWhatSent_Click" />
                                </WrapPanel>
                            </Grid>
                            <TextBlock x:Name="AiStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModulePanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource SectionName}" Margin="0,0,0,10" />

            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Dim}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ReadOnlyText" Text="read only  v0.1" Style="{StaticResource Label}" DockPanel.Dock="Right" Margin="12,0,0,0"
                           ToolTip="This app watches and never changes or stops anything." />
                <TextBlock x:Name="StatusText" Style="{StaticResource Label}" Text="looking for solidworks..." TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <!-- Kept for the tooltip on "read only" (hover there to see when it last checked and where logs go) -->
            <TextBlock x:Name="UpdatedText" Style="{StaticResource Label}" Visibility="Collapsed" />
            <TextBlock x:Name="DataFoldersText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
            <!-- A small credit line, only if one is set in this PC's settings (never written into the code). -->

        
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
