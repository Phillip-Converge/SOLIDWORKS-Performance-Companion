                        <StackPanel>
                            <TextBlock x:Name="HangAiFrom" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBox x:Name="HangAiText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="13.5" />
                        </StackPanel>
                    </Border>
                    <!-- Still unclear? Two more levels, one click each. -->
                    <Button x:Name="HangMoreKey" Content="Explain more" Style="{StaticResource KeyButton}" HorizontalAlignment="Left" Margin="0,8,0,8"
