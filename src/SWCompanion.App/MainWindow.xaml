                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="18" Margin="0,0,0,6">
                                        <Run Text="{Binding Word, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Plain, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="Look into it further" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                    <ItemsControl x:Name="HangLook" Margin="0,2,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="•" FontSize="13" Width="14" />
                                    <TextBlock Text="{Binding}" FontSize="13" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Ask your own AI about this item (only when Ask AI is set up) -->
                    <Button x:Name="HangAskKey" Content="Ask AI about this" Style="{StaticResource KeyButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
