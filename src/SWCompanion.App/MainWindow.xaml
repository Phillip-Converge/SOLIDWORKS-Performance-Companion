<Window x:Class="SWCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion for SOLIDWORKS" Width="1000" Height="860" MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BodyPattern}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <!-- The one clear next step: a rounded, filled button (the guide's main action) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{DynamicResource Accent}" CornerRadius="22" Padding="22,11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.75" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar page buttons: quiet until picked; the picked one is tinted -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,1,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg}" /></Trigger>
                            <Trigger Property="Tag" Value="on"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>        <!-- Reply buttons under the conversation: rounded pills; the suggested answer is filled -->
        <Style x:Key="ReplyChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="Tag" Value="on"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on"><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Text boxes follow the light or dark look (Windows' own default is always white). -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>    </Window.Resources>    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar: the name and the pages ===== -->
        <Border Background="{DynamicResource Module}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,14,18">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <TextBlock Text="Companion" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="for SOLIDWORKS" Style="{StaticResource Label}" />
                </StackPanel>
                <!-- Who created the Companion, small at the very bottom (AppInfo.Credit). -->
                <TextBlock x:Name="CreditText" DockPanel.Dock="Bottom" Style="{StaticResource Label}" FontSize="10.5" Opacity="0.5" TextWrapping="Wrap"
                           Margin="8,6,0,0" Visibility="Collapsed" />
                <TextBlock DockPanel.Dock="Bottom" Text="read only: watches, never changes" Style="{StaticResource Label}" Margin="8,0,0,0" TextWrapping="Wrap" />
                <!-- Switch to the slim always-on-top strip (for the edge of a second monitor) -->
                <Button x:Name="StripKey" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="StripKey_Click" Margin="0,0,0,10"
                        ToolTip="Shrink to a slim strip that stays on top, out of the way. It widens with an explanation if SOLIDWORKS slows down.">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73F;" Style="{StaticResource NavIcon}" /><TextBlock Text="Slim strip" /></StackPanel>
                </Button>
                <!-- Pages: one topic at a time -->
                <StackPanel x:Name="Nav" DockPanel.Dock="Top">
                    <Button x:Name="NavPerformance" Style="{StaticResource NavButton}" Tag="on" Click="Nav_Click" CommandParameter="performance">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" Style="{StaticResource NavIcon}" /><TextBlock Text="Performance" /></StackPanel>
                    </Button>
                    <Button x:Name="NavFixes" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="fixes">
                        <DockPanel>
                            <Border x:Name="NavFixesBadge" DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="9" Padding="7,0" Visibility="Collapsed">
                                <TextBlock x:Name="NavFixesCount" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}" /><TextBlock Text="Fixes" /></StackPanel>
                        </DockPanel>
                    </Button>
                    <Button x:Name="NavCrashes" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="crashes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" Style="{StaticResource NavIcon}" /><TextBlock Text="Crashes" /></StackPanel>
                    </Button>
                    <Button x:Name="NavDetails" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="details">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource NavIcon}" /><TextBlock Text="Details" /></StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" /><TextBlock Text="Settings" /></StackPanel>
                    </Button>
                </StackPanel>
                <!-- The basics, live: the last minute of each as a small chart. Orange: whole PC. Blue: SOLIDWORKS. -->
                <ScrollViewer x:Name="SideVitalsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,10">
                    <StackPanel x:Name="SideVitals" Margin="8,0,2,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="last minute" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="10" Height="3" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="PC" Style="{StaticResource Label}" Margin="0,0,8,0" />
                                <Rectangle Width="10" Height="3" Fill="{DynamicResource Info}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="SW" Style="{StaticResource Label}" ToolTip="SOLIDWORKS" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel ToolTip="The processor (CPU) is the part of the computer that does the calculating: rebuilds, opens, drawing views. Orange: the whole PC. Blue: SOLIDWORKS. As a share of the whole processor, over the last minute."><TextBlock x:Name="SideCpu" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Processor" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideCpuChart" Height="30" Margin="0,3,0,2" />
                        <TextBlock x:Name="SideCpuSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                        <DockPanel ToolTip="A processor is made of several cores, each working on one job at a time. Each bar is one core, right now. SOLIDWORKS does most modelling work on one core, so one tall bar with the rest low is normal during a rebuild, and it can be flat out even when the processor overall looks quiet."><TextBlock x:Name="SideCores" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Cores" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideCoresChart" Height="24" Margin="0,3,0,10" />

                        <DockPanel ToolTip="Memory (RAM) is the computer's fast working space: everything you have open sits in it. When it fills up, the computer slows down. Orange: in use on the whole PC. Blue: SOLIDWORKS. The top of the chart is all the memory in this PC."><TextBlock x:Name="SideMem" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Memory" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideMemChart" Height="30" Margin="0,3,0,2" />
                        <TextBlock x:Name="SideMemSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                        <DockPanel ToolTip="The graphics card (GPU) draws the picture on screen; SOLIDWORKS uses it to show and spin models. Orange: how busy it is. Blue: how much of that is SOLIDWORKS. Below: its own memory in use."><TextBlock x:Name="SideGpu" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Graphics" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideGpuChart" Height="30" Margin="0,3,0,2" />
                        <TextBlock x:Name="SideGpuSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                        <DockPanel ToolTip="The disk (like C:) is where files are stored. This is what SOLIDWORKS is reading and writing on it, for example while opening or saving. The chart's top is the busiest second in the last minute."><TextBlock x:Name="SideDisk" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Disk (SW)" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideDiskChart" Height="30" Margin="0,3,0,10" />

                        <DockPanel ToolTip="The network is the connection to other computers, such as file servers and the PDM vault. This is everything going in and out on the whole PC. The chart's top is the busiest second in the last minute."><TextBlock x:Name="SideNet" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="Network" FontSize="12.5" /></DockPanel>
                        <ContentControl x:Name="SideNetChart" Height="30" Margin="0,3,0,2" />
                        <TextBlock x:Name="SideNetSub" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content: what's happening (always), then the page you picked ===== -->
        <Grid Grid.Column="1" Margin="28,20,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
<Border x:Name="NowPanel" Margin="24,0,16,0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                <DockPanel>
                    <Border x:Name="NowStrip" Width="11" Height="11" CornerRadius="6" Background="{StaticResource Dim}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel x:Name="NowHeader" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="NowChevron" Visibility="Collapsed" />
                        <!-- Things that came and went: click to jump to the list -->
                        <Border x:Name="CaughtBadge" Style="{StaticResource Tag}" Background="{StaticResource Warn}" Margin="0,0,10,0"
                                Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Show what was caught (section 00)">
                            <TextBlock x:Name="CaughtBadgeText" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TagText}" />
                        </Border>
                        <TextBlock x:Name="NowClock" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer x:Name="NowScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="NowHeadline" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                       Text="Looking for SOLIDWORKS..." />
                            <TextBlock x:Name="NowSubline" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            <!-- The causes feed the log and the issues list; kept here hidden for the code that fills them. -->
                            <ItemsControl x:Name="NowCauses" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>

            <Grid Grid.Row="1">
            <!-- Performance (live): the answer, four numbers, where it's held up, the last few minutes, the log -->
            <ScrollViewer x:Name="PagePerformance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
<Border x:Name="FreezeBox" Style="{StaticResource ModulePanel}" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
            <StackPanel>
                <!-- Big slowdown alert: only for obvious, large problems -->
                <Border x:Name="AlertBanner" Background="{StaticResource Alarm}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="BIG SLOWDOWN" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="White" Opacity="0.85" />
                        <TextBlock x:Name="AlertTitle" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock x:Name="AlertFix" FontSize="13.5" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="AlertMore" FontSize="12" Foreground="White" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <!-- During a freeze: is it still working, or has it stopped? -->
                <Border x:Name="VerdictBox" Padding="0" Margin="0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="VerdictBadge" Style="{StaticResource Tag}" Background="{StaticResource Ok}" Margin="0,0,10,0">
                                <TextBlock x:Name="VerdictBadgeText" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock x:Name="VerdictTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="VerdictClock" Style="{StaticResource Label}" Margin="0,4,0,0" />
                        <TextBlock x:Name="VerdictEvidence" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border x:Name="VerdictAdviceBox" Style="{StaticResource AnswerPanel}" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="VerdictAdvice" FontSize="13" LineHeight="19" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NowTimeline" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="NowLastFreeze" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
            <!-- One compact strip: the guide's latest word, your replies and questions, where it's held up, and the last slow wait.
                 Kept small so "what's happening" and "hung up" below get most of the window. -->
            <Border x:Name="TopStrip" Style="{StaticResource ModulePanel}" Padding="18,12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="GuideBadge" Width="30" Height="30" CornerRadius="15" Background="{StaticResource Ok}"
                                DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0">
                            <TextBlock x:Name="GuideBadgeText" Text="&#x2713;" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ChatToggle" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" Cursor="Hand" FontSize="12.5"
                                   VerticalAlignment="Top" Margin="12,6,0,0" Text="conversation ›" MouseLeftButtonUp="ChatToggle_Click"
                                   ToolTip="Show or hide the earlier messages" />
                        <!-- Latest message only, unless you open the conversation -->
                        <ScrollViewer x:Name="ChatScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ChatRows" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="{Binding Align}" Background="{Binding Fill}" CornerRadius="12" Padding="12,7"
                                                Margin="0,0,0,6" MaxWidth="900">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="{Binding TitleSize}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{Binding Ink}" Visibility="{Binding TitleVisibility}" />
                                                <TextBlock Text="{Binding Text}" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Foreground="{Binding SubInk}"
                                                           Margin="{Binding TextMargin}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Replies and your own question, on one line -->
                    <DockPanel Margin="42,4,0,0">
                        <ItemsControl x:Name="ChatReplies" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Tag="{Binding Primary}" Style="{StaticResource ReplyChip}" Click="ChatReply_Click"
                                            Padding="12,4" FontSize="13" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Ask your own AI (set up in Settings). The answer appears above. -->
                        <DockPanel x:Name="AskRow" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <Button x:Name="AskKey" DockPanel.Dock="Right" Content="Ask" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="16,5" Click="Ask_Click" />
                            <TextBlock DockPanel.Dock="Right" Text="what's sent?" Foreground="{StaticResource Accent}" Cursor="Hand" VerticalAlignment="Center"
                                       FontSize="12" Margin="8,0,0,0" MouseLeftButtonUp="AskWhatSent_Click" ToolTip="See exactly what would go to the AI, with names hidden" />
                            <Grid>
                                <TextBox x:Name="AskBox" FontSize="13.5" Padding="8,5" VerticalContentAlignment="Center" KeyDown="AskBox_KeyDown"
                                         TextChanged="AskBox_TextChanged" />
                                <TextBlock x:Name="AskHint" IsHitTestVisible="False" Foreground="{StaticResource Dim}" FontSize="13.5" Margin="11,0,0,0"
                                           VerticalAlignment="Center" Text="Ask your AI about what SOLIDWORKS is doing..." />
                            </Grid>
                        </DockPanel>
                        <TextBlock x:Name="AskSetup" Margin="10,0,0,0" Foreground="{StaticResource Accent}" Cursor="Hand" FontSize="12.5" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Text="Ask your own AI: set it up in Settings ›" MouseLeftButtonUp="AskSetup_Click" />
                    </DockPanel>

                    <!-- Where it's held up (small pills) and the last slow wait, on one line -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="held up at" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <!-- Where the time went: one line, only after something slow -->
                            <StackPanel x:Name="BreakdownPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="Breakdown_Click" ToolTip="Click for how the wait splits into its causes">
                                <TextBlock x:Name="BreakdownTitle" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="360"
                                           TextTrimming="CharacterEllipsis" Text="Nothing slow yet." />
                                <Grid x:Name="BreakdownBar" Width="160" Height="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl x:Name="PipelineStages" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <TextBlock Text="&#x203A;" FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                                                       Margin="2,0,4,0" Visibility="{Binding ArrowVisibility}" />
                                            <Border CornerRadius="11" BorderThickness="{Binding EdgeThickness}" BorderBrush="{Binding Edge}" Background="{Binding Fill}"
                                                    Padding="9,3" ToolTip="{Binding Tip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="6,0,0,0" MaxWidth="170"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Flag}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Alarm}" Margin="6,0,0,0"
                                                               Visibility="{Binding FlagVisibility}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <!-- Where the time went, in full: opened by clicking the line above -->
                    <StackPanel x:Name="BreakdownDetail" Visibility="Collapsed" Margin="0,10,0,0">
                        <ItemsControl x:Name="BreakdownRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Seconds}" FontWeight="SemiBold" FontSize="12.5" Width="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding What}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="BreakdownNote" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="How the last freeze or slow open, save or sheet switch splits into its causes (from once-a-second readings)." />
                    </StackPanel>
                </StackPanel>
            </Border>
                    <!-- The running log, and beside it the "hung up" panel that things slide into from the log. -->
                    <Grid x:Name="LogAndHangs" Height="460" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Second row used only on narrow windows, where the panel moves under the log. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
<Border x:Name="StoryPanel" Style="{StaticResource ModulePanel}" Margin="0" Padding="16,12,8,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,8">
