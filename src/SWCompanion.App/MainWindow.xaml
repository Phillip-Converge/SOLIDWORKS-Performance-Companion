                    <StackPanel x:Name="HangMoreBox" Visibility="Collapsed">
                        <TextBlock Text="In more detail" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                        <ItemsControl x:Name="HangMore" Margin="0,2,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="HangTechKey" Content="Still unclear? Show what was recorded" Style="{StaticResource KeyButton}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Click="HangTech_Click" />
