                    <TextBlock x:Name="HangWhat" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Margin="0,2,0,10" />
                    <TextBlock Text="Why it matters" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="HangWhy" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Margin="0,2,0,10" />
                    <StackPanel x:Name="HangSawBox">
                        <TextBlock Text="Windows recorded at the same time" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                        <ItemsControl x:Name="HangSaw" Margin="0,2,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="What to try" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                    <ItemsControl x:Name="HangTry" Margin="0,2,0,10">
