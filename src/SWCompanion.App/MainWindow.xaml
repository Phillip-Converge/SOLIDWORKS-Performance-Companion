                                            <TextBlock Text="look into this" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TagText}" />
                                        </Border>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- One hang-up, explained -->
