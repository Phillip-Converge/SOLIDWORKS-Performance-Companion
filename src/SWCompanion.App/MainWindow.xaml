                    <ItemsControl x:Name="FixSteps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="13"
