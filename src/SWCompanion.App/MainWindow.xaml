                                    <TextBlock Text="{Binding Text}" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Words used here: plain explanations of the computer words above -->
                    <StackPanel x:Name="HangWordsBox">
                        <TextBlock Text="Words used here" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                        <ItemsControl x:Name="HangWords" Margin="0,4,0,10">
