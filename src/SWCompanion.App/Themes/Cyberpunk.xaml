<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark cyberpunk theme. Warm near-black base and coral accent inspired by
        Claude; neon cyan for live data, magenta for alarms, amber for warnings.
        Change a colour here and it changes everywhere.
    -->

    <!-- ===== Colours ===== -->
    <Color x:Key="BgColor">#0E0D0B</Color>
    <Color x:Key="PanelColor">#17150F</Color>
    <Color x:Key="PanelAltColor">#1D1A14</Color>
    <Color x:Key="LineColor">#3A322A</Color>
    <Color x:Key="TextColor">#EDE6DC</Color>
    <Color x:Key="MutedColor">#8C8276</Color>
    <Color x:Key="CoralColor">#D97757</Color>
    <Color x:Key="CyanColor">#39E6FF</Color>
    <Color x:Key="MagentaColor">#FF3D9A</Color>
    <Color x:Key="AmberColor">#FFB547</Color>
    <Color x:Key="GreenColor">#4DFFB5</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Coral" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Selection" Color="#40D97757" />

    <LinearGradientBrush x:Key="AccentLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource CoralColor}" Offset="0" />
        <GradientStop Color="{StaticResource MagentaColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===== Glows ===== -->
    <DropShadowEffect x:Key="CoralGlow" Color="{StaticResource CoralColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.75" />
    <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource CyanColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />

    <!-- ===== Text ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style x:Key="MonoMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect" Value="{StaticResource CyanGlow}" />
    </Style>

    <!-- ===== Panels ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===== Tooltip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Coral}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- ===== Slim dark scroll bars ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Line}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" Margin="1" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" Margin="1" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Program table ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="RowBackground" Value="{StaticResource Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Coral}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource Coral}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Selection}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
