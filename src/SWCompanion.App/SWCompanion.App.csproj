<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window you see. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SWCompanion</AssemblyName>
    <RootNamespace>SWCompanion.App</RootNamespace>
    <!-- The program's icon in File Explorer, the Start menu and pinned taskbar buttons (made by scripts\Make-Icon.ps1). -->
    <ApplicationIcon>Companion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same icon for the windows themselves: top-left corner and the taskbar while running. -->
    <Resource Include="Companion.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SWCompanion.Core\SWCompanion.Core.csproj" />
    <ProjectReference Include="..\SWCompanion.Link\SWCompanion.Link.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Anthropic's official library, for "Ask AI" with your own Claude key (Settings). -->
    <PackageReference Include="Anthropic" Version="13.12.0" />
  </ItemGroup>
</Project>
